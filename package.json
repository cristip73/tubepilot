{
  "name": "tubepilot",
  "version": "1.0.1",
  "description": "Your AI Co-Pilot for YouTube - MCP server for video transcripts, search, and analysis",
  "main": "dist/index.js",
  "bin": {
    "tubepilot": "dist/index.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "anthropic",
    "youtube",
    "youtube-api",
    "transcript",
    "video-analysis",
    "video-transcript",
    "ai",
    "llm",
    "ai-assistant"
  ],
  "author": "ixex",
  "license": "MIT",
  "homepage": "https://github.com/ixex/tubepilot",
  "repository": {
    "type": "git",
    "url": "https://github.com/ixex/tubepilot.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.4.1",
    "googleapis": "^130.0.0",
    "node-cache": "^5.1.2",
    "sharp": "^0.34.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.8",
    "prettier": "^3.8.1",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
